guide_example_en = Decision example for SMCBatteryManager.kext: Needed for battery reporting on supported laptops, but not for all hardware nor as a core boot requirement.

[KEXT:voodoops2controller]
name = VoodooPS2Controller.kext
description_pt = Extensão de kernel para suporte a teclados, mouses e trackpads PS/2.
