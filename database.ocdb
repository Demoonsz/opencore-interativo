guide_steps_en = Identify the hardware using Device Manager hardware IDs or HWiNFO (Windows), lspci/lsusb (Linux), ACPI dumps with SSDTTime/acpidump, or IORegistryExplorer (macOS) as appropriate; check the project README and its version requirements before deciding.
guide_example_pt = Captura do picker é função de diagnóstico/estética.
guide_example_en = Decision example for CrScreenshotDxe.efi: Not required for boot.

[DRIVER:openpartition]
name = OpenPartitionDxe.efi
description_pt = Acesso a certos volumes e Recovery legados.
description_en = Access to selected legacy volumes and Recovery paths.
function_pt = Suporte ao reconhecimento de partições antigas em fluxos de instalação específicos.
function_en = Supports legacy partition recognition in selected installation workflows.
when_pt = Para recuperação de macOS 10.7–10.9 conforme Dortania, não para EFI moderna comum.
when_en = For macOS 10.7–10.9 recovery per Dortania, not common modern EFIs.
